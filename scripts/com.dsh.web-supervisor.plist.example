<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- dsh-web-restart 插件的监督进程模板。安装：复制到
       ~/Library/LaunchAgents/com.dsh.web-supervisor.plist 并按本机情况调整
       ProgramArguments 里的脚本路径、EnvironmentVariables 里的 DSH_BIN / PATH。 -->
  <key>Label</key>
  <string>com.dsh.web-supervisor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOUR_USER/.dsh/scripts/dsh-web-supervisor.sh</string>
    <string>watch</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USER/.dsh/dsh-web-supervisor.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/.dsh/dsh-web-supervisor.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/YOUR_USER</string>
    <key>PATH</key>
    <string>/opt/homebrew/opt/node@24/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    <!-- 若 dsh 不在 PATH（例如 npx 缓存目录），取消注释并填实际路径： -->
    <!-- <key>DSH_BIN</key><string>/path/to/dsh</string> -->
  </dict>
</dict>
</plist>
